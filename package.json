{
  "name": "leadbox",
  "version": "0.1.0",
  "description": "A tiny, dependency-free, embeddable lead-capture widget for small business websites.",
  "license": "MIT",
  "author": "Ricky1800",
  "type": "module",
  "main": "dist/leadbox.esm.js",
  "module": "dist/leadbox.esm.js",
  "unpkg": "dist/leadbox.min.js",
  "jsdelivr": "dist/leadbox.min.js",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "src/index.js",
    "dist/leadbox.min.js"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "size": "node scripts/check-size.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run size"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "happy-dom": "^15.11.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ricky1800/leadbox.git"
  },
  "homepage": "https://github.com/Ricky1800/leadbox#readme",
  "bugs": {
    "url": "https://github.com/Ricky1800/leadbox/issues"
  },
  "keywords": [
    "lead-capture",
    "widget",
    "embeddable",
    "contact-form",
    "small-business",
    "vanilla-js"
  ]
}
